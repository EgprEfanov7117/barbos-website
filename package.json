{
  "name": "barbos-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:demo && vite build && node scripts/prepare-sites-build.mjs",
    "build:cloudflare": "npm run build && node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/deploy-cloudflare.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test:leads": "node --test tests/leads.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:cloudflare": "node --test tests/cloudflare-leads.test.mjs tests/notifications.test.mjs",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "nodemailer": "^10.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "wrangler": "4.154.0"
  }
}
